# Copy to /etc/caddy/caddy.env, fill in, and keep it readable only by root:
#     sudo install -m 600 -o root -g root caddy.env /etc/caddy/caddy.env
#
# It holds the DuckDNS token, which is the one secret in this setup: anything
# holding it can change where the name points.

# The name you registered at duckdns.org, without the .duckdns.org part.
DUCKDNS_SUBDOMAIN=solax

# The token from the top of the DuckDNS page, the same one for all your names.
DUCKDNS_TOKEN=00000000-0000-0000-0000-000000000000

# The full name, which is what the phones will open.
SOLAX_DOMAIN=solax.duckdns.org

# The Pi's address on your network. Give it a fixed one in the router's DHCP
# reservations first, or the name will point at the wrong machine after a reboot.
SOLAX_LAN_IP=192.168.1.50

# Where Let's Encrypt writes if a renewal starts failing.
ACME_EMAIL=you@example.com
