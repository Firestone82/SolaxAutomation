[Unit]
Description=Caddy, terminating TLS in front of the Solax dashboard
Documentation=https://caddyserver.com/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy
EnvironmentFile=/etc/caddy/caddy.env

# Deliberately without --environ, which the packaged unit passes: it prints every
# environment variable to the journal, and one of ours is the DuckDNS token.
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/caddy/Caddyfile --force

# 443 and 80 are privileged, and Caddy does not run as root to reach them.
AmbientCapabilities=CAP_NET_BIND_SERVICE

Restart=on-failure
RestartSec=5s
TimeoutStopSec=5s
LimitNOFILE=1048576

PrivateTmp=true
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
